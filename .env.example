# Copy this file to .env and replace every CHANGE_ME value locally.
# Never commit .env or share its contents.

POSTGRES_DB=orbit
POSTGRES_USER=orbit_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

N8N_PORT=5678
# Keep this stable after configuring n8n credentials; changing it may make
# stored encrypted credentials unreadable. Back up before rotating it.
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_KEY
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GENERIC_TIMEZONE=America/Sao_Paulo
